{
  "name": "discord-ollama-bot",
  "version": "1.0.0",
  "description": "A lightweight, portable, multimodal Discord Bot with RAG architecture powered by Ollama.",
  "main": "src/backend/app.js",
  "type": "module",
  "scripts": {
    "start:backend": "node src/backend/app.js --watch",
    "start:frontend": "node src/frontend/index.js --watch",
    "dev": "concurrently \"npm run start:backend\" \"npm run start:frontend\""
  },
  "keywords": [
    "discord",
    "ollama",
    "llm",
    "rag",
    "multimodal",
    "express",
    "mongoose"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.6",
    "discord.js": "^14.14.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jschardet": "^3.1.4",
    "mammoth": "^1.12.0",
    "mongoose": "^8.2.2",
    "pdf-parse-new": "^2.1.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}